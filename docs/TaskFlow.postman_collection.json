      "item": [
        {
          "name": "1 - Görev ekle: yüksek öncelik (POST /tasks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('taskId', pm.response.json().id);",
                  "pm.test('varsayılan status pending', () => pm.expect(pm.response.json().status).to.eql('pending'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend kur\",\n  \"description\": \"Express projesini oluştur\",\n  \"priority\": \"high\",\n  \"assignee\": \"musa\"\n}"
            },
            "url": {
